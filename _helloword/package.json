    "@typescript-eslint/eslint-plugin": "^5.59.7",
    "@typescript-eslint/parser": "^5.59.7",
    "auto-changelog": "^2.4.0",
    "docsify-cli": "^4.4.4",
    "google-auth-library": "^10.2.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "varlock": "^0.0.7"
